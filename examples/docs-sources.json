    { "type": "python", "dep": "django", "url": "https://docs.djangoproject.com/en/stable/", "label": "Django docs" },
    { "type": "python", "dep": "fastapi", "url": "https://fastapi.tiangolo.com/", "label": "FastAPI docs" },
    { "type": "python", "dep": "flask", "url": "https://flask.palletsprojects.com/", "label": "Flask docs" },
    { "type": "python", "dep": "pydantic", "url": "https://docs.pydantic.dev/latest/", "label": "Pydantic docs" },
