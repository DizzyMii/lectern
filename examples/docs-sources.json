    { "type": "npm", "dep": "hono", "url": "https://hono.dev/docs/", "label": "Hono docs" },
    { "type": "npm", "dep": "react", "url": "https://react.dev/reference/react", "label": "React reference" },
    { "type": "npm", "dep": "next", "url": "https://nextjs.org/docs", "label": "Next.js docs" },
    { "type": "npm", "dep": "vue", "url": "https://vuejs.org/guide/introduction.html", "label": "Vue guide" },
    { "type": "npm", "dep": "svelte", "url": "https://svelte.dev/docs/svelte/overview", "label": "Svelte docs" },
    { "type": "npm", "dep": "vite", "url": "https://vite.dev/guide/", "label": "Vite guide" },
    { "type": "npm", "dep": "typescript", "url": "https://www.typescriptlang.org/docs/handbook/intro.html", "label": "TypeScript handbook" },
    { "type": "cargo", "dep": "tokio", "url": "https://docs.rs/tokio/latest/tokio/", "label": "docs.rs/tokio" },
    { "type": "cargo", "dep": "axum", "url": "https://docs.rs/axum/latest/axum/", "label": "docs.rs/axum" },
