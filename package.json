{
  "name": "@dizzymii/lectern",
  "version": "1.0.0-rc.1",
  "description": "A local notebook for developers: ask your pinned docs and code roots, get answers with citations checked against the files.",
  "license": "PolyForm-Shield-1.0.0",
  "author": "Kade Heglin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DizzyMii/lectern.git"
  },
  "homepage": "https://github.com/DizzyMii/lectern#readme",
  "bugs": "https://github.com/DizzyMii/lectern/issues",
  "type": "module",
  "main": "electron/main.mjs",
  "bin": {
    "lectern": "bin/lectern.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "electron/",
    "examples/",
    "public/",
    "docs/mcp.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "!public/dev-mock.js",
    "!public/ui/mock-studio.js",
    "!public/studio/harness.html",
    "!public/studio/fixtures.js",
    "!public/studio/mock-data.js",
    "!public/TOKENS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/lectern.mjs serve",
    "app": "electron .",
    "build:exe": "electron-builder --win",
    "test": "node --test test/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/newsreader": "^5.3.0",
    "dompurify": "^3.2.6",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.dizzymii.lectern",
    "productName": "Lectern",
    "asar": false,
    "files": [
      "bin/",
      "lib/",
      "public/",
      "examples/",
      "electron/",
      "package.json",
      "!public/dev-mock.js",
      "!public/ui/mock-studio.js",
      "!public/studio/harness.html",
      "!public/studio/fixtures.js",
      "!public/studio/mock-data.js",
      "!public/TOKENS.md"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Lectern.exe"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Lectern Setup.exe"
    }
  }
}
